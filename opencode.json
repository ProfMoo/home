{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "kubernetes-mcp-server": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "kubernetes-mcp-server@latest",
          "--read-only"
        ],
        "environment": {
          "KUBECONFIG": "/Users/drmoo/.kube/config"
        }
      },
      "prometheus": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "-e",
          "PROMETHEUS_URL",
          "ghcr.io/pab1it0/prometheus-mcp-server:latest"
        ],
        "environment": {
          "PROMETHEUS_URL": "https://prometheus.drmoo.io"
        }
      },
      "grafana": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "-e",
          "GRAFANA_URL",
          "-e",
          "GRAFANA_USERNAME",
          "-e",
          "GRAFANA_PASSWORD",
          "grafana/mcp-grafana",
          "-t",
          "stdio"
        ],
        "environment": {
          "GRAFANA_URL": "https://grafana.drmoo.io",
          "GRAFANA_USERNAME": "username",
          "GRAFANA_PASSWORD": "password"
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "task l:lint*", "effect": "allow" },
    { "action": "shell", "resource": "kubectl kustomize *", "effect": "allow" },
    { "action": "shell", "resource": "kustomize build *", "effect": "allow" }
  ]
}
